# Client (public Firebase web config - not secret, but project specific)
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Server only (never commit real values)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Payments and AdMob stay disabled until configured
PAYMENTS_ENABLED=false
# One-time owner bootstrap: your Firebase Auth UID. Server-only. Remove after first sign-in.
BOOTSTRAP_OWNER_UID=
