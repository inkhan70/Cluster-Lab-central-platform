rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // All writes go through server API routes (Admin SDK bypasses rules).
    // Clients may only read apps if they hold an admin role document.
    function isAdmin() { return exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /apps/{appId} { allow read: if request.auth != null && isAdmin(); allow write: if false; }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
